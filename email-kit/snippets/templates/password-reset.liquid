{%- comment -%}===== START: email-kit/templates/password-reset =====
Admin Body calls this snippet in one line and passes: reset_url, user.
{%- endcomment -%}
{%- capture ek_store -%}{% snippet 'email-kit/store/name' %}{%- endcapture -%}{%- assign ek_store = ek_store | strip -%}
{%- capture ek_subject -%}{% snippet 'email-kit/subjects/password-reset' %}{%- endcapture -%}
{%- capture ek_msg -%}{% snippet 'email-kit/messages/password-reset' %}{%- endcapture -%}
{%- assign ek_first = user.first_name -%}
{%- assign ek_pre = 'Use this link to choose a new password.' -%}
{%- capture ek_body -%}
{% snippet 'email-kit/parts/heading', title: 'Reset your password', code: '', team: false %}
{% snippet 'email-kit/parts/message', message: ek_msg, first_name: ek_first, order_code: '', store_name: ek_store %}
{% snippet 'email-kit/parts/button', label: 'Reset password', url: reset_url %}
{% snippet 'email-kit/parts/link-fallback', url: reset_url %}
{% snippet 'email-kit/parts/note', text: 'Did not ask for this? Ignore this email and your password stays the same.', size: 'small' %}
{%- endcapture -%}
{% snippet 'email-kit/layout', subject: ek_subject, preheader: ek_pre, body: ek_body, audience: 'customer', banner: false %}
{%- comment -%}===== END: email-kit/templates/password-reset ====={%- endcomment -%}
