{%- comment -%}===== START: email-kit/templates/user-signup =====
Admin Body calls this snippet in one line and passes: user.
{%- endcomment -%}
{%- capture ek_store -%}{% snippet 'email-kit/store/name' %}{%- endcapture -%}{%- assign ek_store = ek_store | strip -%}
{%- capture ek_subject -%}{% snippet 'email-kit/subjects/user-signup' %}{%- endcapture -%}
{%- capture ek_msg -%}{% snippet 'email-kit/messages/user-signup' %}{%- endcapture -%}
{%- assign ek_first = user.first_name -%}
{%- assign ek_acct_url = 'https://' | append: website.hostname | append: '/site/account' -%}
{%- assign ek_pre = 'Your account at ' | append: ek_store | append: ' is ready.' -%}
{%- capture ek_body -%}
{% snippet 'email-kit/parts/heading', title: 'Welcome', code: '', team: false %}
{% snippet 'email-kit/parts/message', message: ek_msg, first_name: ek_first, order_code: '', store_name: ek_store %}
{% snippet 'email-kit/parts/button', label: 'Go to your account', url: ek_acct_url %}
{%- endcapture -%}
{% snippet 'email-kit/layout', subject: ek_subject, preheader: ek_pre, body: ek_body, audience: 'customer', banner: true %}
{%- comment -%}===== END: email-kit/templates/user-signup ====={%- endcomment -%}
